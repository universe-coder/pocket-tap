{
  "name": "PocketTap",
  "short_name": "PocketTap",
  "description": "Use your phone as a remote control for your PC",
  "lang": "en",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0f1115",
  "theme_color": "#0f1115",
  "icons": [
    {
      "src": "/static/icon.svg",
      "sizes": "any",
